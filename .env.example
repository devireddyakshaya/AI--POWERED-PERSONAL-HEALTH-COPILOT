# ========================================================
# MediMitra AI — Environment Configuration
# ========================================================

# Google Gemini API Key
# If left blank or invalid, MediMitra AI automatically runs in high-fidelity DEMO MODE
# with synthetic lab data and deterministic explanations.
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM / NVAPI compatibility
# If your key starts with nvapi-, the app will use the NVIDIA chat-completions endpoint.
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Application Environment: development | production | demo
APP_ENV=development

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=5173

# Database URL (SQLite default for hackathon prototype)
DATABASE_URL=sqlite:///./MediMitra.db

# Privacy & Ephemeral Document Processing
# When true, uploaded raw document files are processed in-memory / discarded after extraction
EPHEMERAL_PROCESSING_ONLY=true

# Tesseract OCR executable path (Leave blank if in system PATH, or specify Windows path)
# e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
